{
  "installCommand": "npm install -g pnpm@9 && pnpm install --no-frozen-lockfile --filter @workspace/portfolio",
  "buildCommand": "cd artifacts/portfolio && pnpm run build:deploy",
  "outputDirectory": "artifacts/portfolio/dist",
  "framework": null,
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
