PORT=3001
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# ── Telegram (optional) ──
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-from-botfather
TELEGRAM_CHAT_ID=your-telegram-chat-id

# ── Email via Resend (optional, free: 100/day) ──
# Get your API key at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxx
NOTIFICATION_EMAIL=your-email@gmail.com
# Optional: custom "from" address (must be verified in Resend)
# EMAIL_FROM=onboarding@resend.dev

# ── CORS (required in production) ──
# Comma-separated list of allowed origins. If unset in production, cross-origin
# requests are rejected. Set this to your deployed portfolio URL.
CORS_ALLOWED_ORIGINS=https://ahmadalhariri.dev,https://www.ahmadalhariri.dev
